# Postgres connection string. Create a free Neon project at https://neon.tech
# and copy the pooled connection string from its dashboard.
DATABASE_URL=

# Random secret for better-auth session signing. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public base URL of the app, with no slash at the end. http://localhost:3000 locally, the Vercel URL in production.
# Claude connects to this address plus /api/mcp.
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client ID. Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
GOOGLE_CLIENT_ID=

# Google OAuth client secret, from the same OAuth client as GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_SECRET=

# Media storage (optional: without these two the app runs, and the Media tab says uploads are not set up).
# The Google service account's JSON key file, base64-encoded on one line: base64 -i key.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT_KEY=

# The id of the folder that holds the media (a folder inside a Google shared drive, shared with the service account): the part of the folder's address after /folders/.
DRIVE_FOLDER_ID=

# Spaces storage: the key that seals each connected Google Drive's refresh token. 32 random bytes, base64: openssl rand -base64 32
STORAGE_TOKEN_KEY=

# Optional: posting exports to YouTube (docs/setup.md, "Posting to YouTube"). The Google sign-in client allowed to use
# the YouTube API; it can be the one above. Needs STORAGE_TOKEN_KEY too. Unset, there is no Socials tab and no Post button.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Optional: "true" lets anyone with a Google account sign up. Leave unset until the Google sign-in screen is published.
OPEN_SIGNUP=

# Optional: "true" offers everyone their personal space. Unset, EasyEdit is for teams: a personal space's page says it is coming soon.
PERSONAL_SPACES=

# Optional: an https link to the intro tutorial video (an MP4, with a JPG of the same name beside it for its poster). Unset, there is no welcome dialog and no Tutorial item in the account menu.
TUTORIAL_VIDEO_URL=

# Daily database size alert (docs/setup.md, "Database size alert"). Production only; leave unset locally.
# CRON_SECRET=
# NTFY_TOPIC=
# NEON_API_KEY=
# NEON_PROJECT_ID=
